# HTTP bind settings.
# Listen on all interfaces for container platforms and reverse proxies.
HOST=0.0.0.0
PORT=4010

# Directory for encrypted env blobs, revision acknowledgements, and pairing bundles.
INTER_ENV_SERVER_DATA=./data

# Optional shared token for private/self-hosted deployments.
# Clients can use: INTER_ENV_SERVER_URL="https://private.example.com/change-me"
INTER_ENV_SERVER_TOKEN=change-me

# Optional limits.
INTER_ENV_MAX_BYTES=10485760
# Maximum registered projects per account.
INTER_ENV_MAX_PROJECTS=100
INTER_ENV_PAIR_TTL_MS=900000
